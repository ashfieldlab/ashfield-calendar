# =============================================================================
# Ashfield Calendar: 운영 환경 변수 (docs/deploy.md)
#
# 서버에서 `scripts/prod.sh init-env` (로컬: make deploy-init) 가 이 파일을 .env.prod 로 복사하고
# __GENERATE__ 는 openssl 로, __FROM_ACCOUNT__ 는 계정 서버의 .secrets/clients.local.json 에서 채운다.
# .env.prod 는 서버에만 둔다 (gitignore).
# =============================================================================

COMPOSE_PROJECT_NAME=ashfield-calendar-prod

# ───── 포트 (LAN 바인딩: 앞단 리버스 프록시가 받는다). backend 는 열지 않는다.
FRONTEND_HOST_PORT=3100
CALDAV_HOST_PORT=3101

# ───── 주소
# 이 앱의 공개 주소. 계정 서버 로그인 콜백 ${BETTER_AUTH_URL}/api/auth/callback/ashfield,
# 토큰 aud(백엔드 AUTH_AUDIENCE), 이메일, 구독, CalDAV 링크의 기준. = 계정 서버의 CALENDAR_URL
BETTER_AUTH_URL=https://calendar.ashfieldlab.dev
# 계정 서버 주소 (issuer). 백엔드 AUTH_JWKS_URL, AUTH_ISSUER 도 여기서 만든다.
ACCOUNT_URL=https://account.ashfieldlab.dev
# 헤더의 파일 앱 링크 (빌드 때 굳는다). 비우면 숨김.
NEXT_PUBLIC_DRIVE_URL=https://drive.ashfieldlab.dev

# ───── 비밀값
POSTGRES_USER=ashfield
POSTGRES_PASSWORD=__GENERATE__
POSTGRES_DB=ashfield_calendar
# 앱 세션 쿠키 암호화
BETTER_AUTH_SECRET=__GENERATE__
# DB 에 저장하는 SMTP 비밀번호 암호화 키 (Fernet)
SMTP_ENCRYPTION_KEY=__GENERATE__
# 계정 서버에 등록된 client (계정 서버 배포가 .secrets/clients.local.json 에 저장)
ASHFIELD_CLIENT_ID=ashfield-calendar
ASHFIELD_CLIENT_SECRET=__FROM_ACCOUNT__

# System Admin 이메일 (쉼표 구분). init-env 에 ADMIN_EMAIL 을 주면 비어 있을 때 채운다.
SYSTEM_ADMIN_EMAILS=

# ───── SMTP: 끄면 메일은 보내지 않고 로그만 남긴다
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_FROM=
SMTP_FROM_NAME=Ashfield

# ───── 기타 (기본값으로 충분)
# 워크스페이스마다 자동 구독할 공휴일 ICS URL. 비우면 만들지 않는다.
HOLIDAYS_ICS_URL=
# 공개 라우트 보호 (ADR-0011)
PUBLIC_RATE_LIMIT_PER_IP=1000
PUBLIC_RATE_LIMIT_PER_EMAIL=1
BOOKING_PII_RETENTION_DAYS=30
# 백엔드 debug 로그 카테고리: 운영은 비움
LOG_CATEGORIES=
