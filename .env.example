# =============================================================================
# Ashfield Calendar — 루트 .env (docker-compose + backend)
#
# 사용: cp .env.example .env  후 채워서 사용.
# 프론트엔드용 변수는 frontend/.env.example 참조 (Next.js는 부모 .env를 안 읽음).
# =============================================================================


# =============================================================================
# 환경 구분
# =============================================================================
ENVIRONMENT=development


# =============================================================================
# Compose 프로젝트 격리 (포트·이름 충돌 회피)
#
# 새 프로젝트 시작 시 — 두 줄만 자기 값으로 변경:
#   1. COMPOSE_PROJECT_NAME: 프로젝트 이름
#   2. *_HOST_PORT: 호스트 포트 (다른 로컬 프로젝트와 충돌 회피)
# =============================================================================
COMPOSE_PROJECT_NAME=ashfield-calendar

# 호스트 포트: Ashfield 앱끼리 겹치지 않게 (docs/local-dev.md "포트"). Account 3300·5632,
# Calendar 3100·8100·15542·16489·11035·18035·18090, Drive 3200·8200·15532·16479·11025·18025·19200·19201.
POSTGRES_HOST_PORT=15542
REDIS_HOST_PORT=16489
MAILPIT_SMTP_HOST_PORT=11035   # dev SMTP catcher
MAILPIT_WEB_HOST_PORT=18035    # mailpit 웹 UI

# Postgres 자격증명 (개발 전용 — 운영은 별도 secrets)
POSTGRES_USER=ashfield
POSTGRES_PASSWORD=ashfield_dev
POSTGRES_DB=ashfield_calendar


# =============================================================================
# Backend (pydantic-settings)
# =============================================================================

DATABASE_URL=postgresql+asyncpg://ashfield:ashfield_dev@localhost:15542/ashfield_calendar
REDIS_URL=redis://localhost:16489

# -----------------------------------------------------------------------------
# 인증: Ashfield 계정 서버(OIDC)가 발급한 액세스 토큰(JWT) 검증 (ADR-0024)
#
# 계정 서버(ashfield-account, 기본 http://localhost:3300)가 issuer. 셋 다 필수 (비면 인증 요청이 503,
# ENVIRONMENT=production 이면 부팅 거부).
#   AUTH_AUDIENCE = 이 앱의 공개 주소 = frontend/.env 의 BETTER_AUTH_URL (= 계정 서버 CALENDAR_URL)
# 가입 허용(허용 이메일)·로그인 수단은 계정 서버 설정이다.
# -----------------------------------------------------------------------------
AUTH_JWKS_URL=http://localhost:3300/api/auth/jwks
AUTH_ISSUER=http://localhost:3300
AUTH_AUDIENCE=http://localhost:3100

# System Admin 이메일 (쉼표 구분). users.is_system_admin 컬럼과 OR.
SYSTEM_ADMIN_EMAILS=


# =============================================================================
# SMTP (이메일 알림)
# =============================================================================

# dev: docker-compose 의 mailpit (실제 발송 X — http://localhost:18035 web UI 로 확인).
# 운영: SES/Mailgun/Gmail 등 실제 SMTP.
SMTP_ENABLED=true
SMTP_HOST=localhost
SMTP_PORT=11035
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_FROM=noreply@ashfield.local
SMTP_FROM_NAME=Ashfield
# 이메일·구독·CalDAV 링크 base URL (ashfield-calendar 앱 origin). dev 는 기본값이면 충분.
CALENDAR_BASE_URL=http://localhost:3100

# 회사마다 자동 시드되는 기본 공휴일 캘린더(external_ics) URL. 빈 값이면 시드 안 함.
HOLIDAYS_ICS_URL=

# DB 에 저장되는 SMTP 비밀번호 암호화 키 (Fernet 32 bytes base64).
# 발급: `python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`
# 운영은 secret manager. 분실 시 SMTP 재설정만 하면 됨.
SMTP_ENCRYPTION_KEY=


# =============================================================================
# 공개 라우트 (ADR-0011) — /api/public/v1/* 비인증 엔드포인트 보호
# =============================================================================

# 같은 IP 분당 요청 수 한도. 모든 공개 엔드포인트 합산 (GET·POST 다 카운트).
# 기본 1000 — CGNAT(모바일 캐리어·공유 WiFi) 환경에서도 안 막힘.
# 실제 어뷰즈 방어선은 per-email + honeypot. 운영 관찰 후 줄여도 무방.
PUBLIC_RATE_LIMIT_PER_IP=1000

# 같은 이메일 주소로 submit 분당 한도. 1 = 더블 클릭·봇 반복 방어 (권장).
# 0 = 비활성. 한 사람이 여러 슬롯 같이 잡아야 하면 임시로 3-5 정도.
PUBLIC_RATE_LIMIT_PER_EMAIL=1


# =============================================================================
# 보관 기간 (PIPA 대응 + 운영)
# =============================================================================

# Booking PII 마스킹 — slot 종료 + N일 후 customer_name/email/message 등 NULL.
# row 자체는 통계용 보존. PIPA 제21조(지체 없이 파기) 대응.
BOOKING_PII_RETENTION_DAYS=30


# =============================================================================
# 로깅 (백엔드)
# =============================================================================

LOG_CATEGORIES=

# CalDAV (ADR-0014) — Sabre PHP 컨테이너 외부 노출 포트
CALDAV_HOST_PORT=18090

# dev 서버 포트 (make frontend / make backend / make e2e). Account 3300 · Drive 3200/8200 과 겹치지 않게.
FRONTEND_PORT=3100
BACKEND_PORT=8100
